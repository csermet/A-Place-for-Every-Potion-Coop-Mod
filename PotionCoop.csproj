<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PotionCoop</AssemblyName>
    <RootNamespace>PotionCoop</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>embedded</DebugType>
    <GameDir>$(MSBuildThisFileDirectory)..\game</GameDir>
    <MelonDir>$(GameDir)\MelonLoader</MelonDir>
    <!-- Il2Cpp interop assemblies trip a few harmless warnings -->
    <NoWarn>$(NoWarn);CS0436;MSB3277;MSB3243</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(MelonDir)\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(MelonDir)\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(MelonDir)\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(MelonDir)\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(MelonDir)\net6\Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(MelonDir)\Il2CppAssemblies\*.dll" Private="false" />
  </ItemGroup>

  <!-- Drop the built mod straight into the game's Mods folder -->
  <Target Name="CopyToMods" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" />
  </Target>

</Project>
